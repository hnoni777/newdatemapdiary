<?xml version="1.0" encoding="utf-8"?>
<!-- 🌌 [프리미엄 보더리스 3D 효과] - 테두리 없이 그림자와 광채만으로 깊이감 표현 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 1. 하단/우측: 깊은 대칭 그림자 (범위 확장) -->
    <item android:top="12dp" android:left="12dp">
        <shape>
            <corners android:radius="22dp" />
            <solid android:color="#CC000000" />
        </shape>
    </item>

    <!-- 2. 상단/좌측: 은은한 면 반사광 (범위 확장) -->
    <item android:bottom="10dp" android:right="10dp">
        <shape>
            <corners android:radius="22dp" />
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- 3. 본체: 매트한 다크 그레이 (주변 그림자와 대비되어 입체감 형성) -->
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#121212" />
        </shape>
    </item>

</layer-list>
