<?xml version="1.0" encoding="utf-8"?>
<!-- 🌌 [프리미엄 플로팅 글래스 효과] - 은은한 금빛 광채와 깊은 입체감 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 1. 바닥으로 흐르는 깊은 그림자 (Elevation 효과 극대화) -->
    <item android:bottom="4dp" android:right="4dp" android:left="4dp" android:top="4dp">
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="#44000000" />
        </shape>
    </item>

    <!-- 2. 신비로운 네온 골드 글로우 (아래쪽으로 은은하게 퍼지는 빛) -->
    <item android:bottom="2dp" android:right="2dp" android:left="2dp" android:top="2dp">
        <shape>
            <corners android:radius="22dp" />
            <solid android:color="#1AD4AF37" />
        </shape>
    </item>

    <!-- 3. 본체: 깊이감 있는 다크 그라데이션 (금속 베젤 느낌) -->
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#333333"
                android:centerColor="#111111"
                android:endColor="#000000"
                android:angle="270" />
            <!-- 매끈하게 빛나는 샴페인 골드 테두리 -->
            <stroke android:width="1.5dp" android:color="#FFE6D7B0" />
        </shape>
    </item>

    <!-- 4. 상단 하이라이트 (빛이 위에서 떨어지는 듯한 효과) -->
    <item android:bottom="18dp" android:right="1dp" android:left="1dp" android:top="1dp">
        <shape>
            <corners android:radius="19dp" />
            <gradient
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
