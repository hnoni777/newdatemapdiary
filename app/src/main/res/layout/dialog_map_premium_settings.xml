<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark_premium"
    android:padding="16dp">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨"
            android:textSize="18sp"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="지도 꾸미기"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/kyobo_hand_family" />
    </LinearLayout>

    <!-- 이동수단 선택: 짤림 방지 특화 설계 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_section_dark"
        android:padding="10dp"
        android:layout_marginBottom="12dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이동수단 선택"
            android:textSize="12sp"
            android:textColor="#BBBBBB"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/kyobo_hand_family" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/ll_vehicle_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingEnd="32dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:gravity="center_vertical">

                <!-- 개별 아이템: RadioButton의 짤림을 막기 위해 padding/margin을 대폭 확보한 FrameLayout 기반 -->
                <FrameLayout
                    android:id="@+id/container_jet"
                    android:layout_width="72dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_vehicle_item_selector">
                    
                    <RadioButton
                        android:id="@+id/rb_jet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFD700"
                        android:clickable="false"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="6dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/img_premium_jet" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="제트기"
                            android:textSize="10sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kyobo_hand_family" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/container_balloon"
                    android:layout_width="72dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_vehicle_item_selector">
                    <RadioButton
                        android:id="@+id/rb_balloon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFD700"
                        android:clickable="false"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="6dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/img_premium_balloon" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="열기구"
                            android:textSize="10sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kyobo_hand_family" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/container_rocket"
                    android:layout_width="72dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_vehicle_item_selector">
                    <RadioButton
                        android:id="@+id/rb_rocket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFD700"
                        android:clickable="false"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="6dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/img_premium_rocket" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="로켓"
                            android:textSize="10sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kyobo_hand_family" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/container_ufo"
                    android:layout_width="72dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_vehicle_item_selector">
                    <RadioButton
                        android:id="@+id/rb_ufo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFD700"
                        android:clickable="false"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="6dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/img_premium_ufo" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UFO"
                            android:textSize="10sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kyobo_hand_family" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/container_paper_airplane"
                    android:layout_width="72dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_vehicle_item_selector">
                    <RadioButton
                        android:id="@+id/rb_paper_airplane"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFD700"
                        android:clickable="false"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="6dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/img_premium_paperairplane" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="종이비행기"
                            android:textSize="10sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kyobo_hand_family" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/container_paper_hak"
                    android:layout_width="72dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_vehicle_item_selector">
                    <RadioButton
                        android:id="@+id/rb_paper_hak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFD700"
                        android:clickable="false"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="6dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/img_premium_paperhak" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="종이학"
                            android:textSize="10sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kyobo_hand_family" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/container_henry"
                    android:layout_width="72dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_vehicle_item_selector">
                    <RadioButton
                        android:id="@+id/rb_henry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFD700"
                        android:clickable="false"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="6dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/img_premium_henry" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="헬리콥터"
                            android:textSize="10sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kyobo_hand_family" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_section_dark"
        android:padding="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="비행 경로 색상"
            android:textSize="12sp"
            android:textColor="#BBBBBB"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/kyobo_hand_family" />

        <LinearLayout
            android:id="@+id/ll_color_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <RadioButton
                android:id="@+id/rb_color_gray"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:button="@null"
                android:background="@drawable/bg_color_dot_selector"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="#B0E0E0E0" />
            
            <RadioButton
                android:id="@+id/rb_color_gold"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:button="@null"
                android:background="@drawable/bg_color_dot_selector"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="#B0FFD700" />

            <RadioButton
                android:id="@+id/rb_color_pink"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:button="@null"
                android:background="@drawable/bg_color_dot_selector"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="#B0FF9999" />

            <RadioButton
                android:id="@+id/rb_color_blue"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:button="@null"
                android:background="@drawable/bg_color_dot_selector"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="#B087CEEB" />
        </LinearLayout>
    </LinearLayout>

    <!-- 📍 [핀 스타일 선택] 통합 셀렉터 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 지도 핀 스타일 선택"
        android:textColor="#FFD700"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/kyobo_hand_family" />

    <RadioGroup
        android:id="@+id/rg_marker_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_section_dark"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <RadioButton
            android:id="@+id/rb_marker_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧡 기본 하트 핀"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:buttonTint="#FFD700"
            android:fontFamily="@font/kyobo_hand_family" />

        <RadioButton
            android:id="@+id/rb_marker_photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📸 추억 사진 핀"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:buttonTint="#FFD700"
            android:fontFamily="@font/kyobo_hand_family" />

        <RadioButton
            android:id="@+id/rb_marker_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 프로필 사진 핀"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:buttonTint="#FFD700"
            android:fontFamily="@font/kyobo_hand_family" />
    </RadioGroup>

    <!-- 💑 [서브] 커플 프로필 관리 (프로필 핀 선택 시에 주로 사용) -->
    <TextView
        android:id="@+id/btn_open_profile_manager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️ 프로필 관리 / 새로 만들기 >"
        android:textColor="#B0B0B0"
        android:textSize="11sp"
        android:gravity="end"
        android:layout_marginBottom="14dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/kyobo_hand_family" />

    <Button
        android:id="@+id/btn_save_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="💾 설정 저장하기"
        android:backgroundTint="#FFD700"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="@font/kyobo_hand_family"
        app:cornerRadius="12dp" />

</LinearLayout>
