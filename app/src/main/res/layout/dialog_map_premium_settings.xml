<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_white_card_round"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="지도 꾸미기"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:fontFamily="@font/kyobo_hand_family"
        android:layout_marginBottom="24dp" />

    <!-- 🛸 [탈것] 추억여행 이동수단 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="추억여행 이동수단"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_gravity="start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp" />

    <!-- 🛠️ 가로 스크롤 방식으로 변경 (창 높이 최적화) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:id="@+id/ll_vehicle_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:id="@+id/container_jet"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <RadioButton
                    android:id="@+id/rb_jet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/img_premium_jet" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="제트기"
                    android:textSize="11sp"
                    android:fontFamily="@font/kyobo_hand_family"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_balloon"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <RadioButton
                    android:id="@+id/rb_balloon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/img_premium_balloon" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="열기구"
                    android:textSize="11sp"
                    android:fontFamily="@font/kyobo_hand_family"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_rocket"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <RadioButton
                    android:id="@+id/rb_rocket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/img_premium_rocket" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="로켓"
                    android:textSize="11sp"
                    android:fontFamily="@font/kyobo_hand_family"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_ufo"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <RadioButton
                    android:id="@+id/rb_ufo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/img_premium_ufo" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UFO"
                    android:textSize="11sp"
                    android:fontFamily="@font/kyobo_hand_family"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_paper_airplane"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <RadioButton
                    android:id="@+id/rb_paper_airplane"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/img_premium_paperairplane" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="종이비행기"
                    android:textSize="11sp"
                    android:fontFamily="@font/kyobo_hand_family"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_paper_hak"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <RadioButton
                    android:id="@+id/rb_paper_hak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/img_premium_paperhak" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="종이학"
                    android:textSize="11sp"
                    android:fontFamily="@font/kyobo_hand_family"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_henry"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <RadioButton
                    android:id="@+id/rb_henry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false" />
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/img_premium_henry" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="헬리콥터"
                    android:textSize="11sp"
                    android:fontFamily="@font/kyobo_hand_family"/>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 🎨 [색상] 라인 색상 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="라인 색상"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_gravity="start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <!-- 직접 RadioButton들을 관리하기 위해 LinearLayout으로 전환 -->
    <LinearLayout
        android:id="@+id/ll_color_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/rb_color_gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#E0E0E0" />
        
        <RadioButton
            android:id="@+id/rb_color_gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#FFD700" />

        <RadioButton
            android:id="@+id/rb_color_pink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#FF9999" />

        <RadioButton
            android:id="@+id/rb_color_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#87CEEB" />
    </LinearLayout>
    
    <!-- 📸 [포토핀] 포토핀 설정 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        android:padding="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="포토핀 설정"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/kyobo_hand_family" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_photo_markers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_save_settings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="💾 설정 저장하기"
        android:backgroundTint="#FFD700"
        android:textColor="#000000"
        android:textStyle="bold"
        android:fontFamily="@font/kyobo_hand_family"
        app:cornerRadius="16dp" />

</LinearLayout>
