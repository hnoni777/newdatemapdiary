<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_dark_premium"
    android:padding="20dp"
    android:layout_gravity="center">

    <!-- 📸 초대장 사진 미리보기 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_invitation_photo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#00000000"
        app:layout_constraintDimensionRatio="4:3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_invitation_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:color/transparent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_white_card_round"
            android:alpha="0.05" />
    </androidx.cardview.widget.CardView>

    <!-- 💌 타이틀 -->
    <TextView
        android:id="@+id/tv_invitation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="연인의 소중한 초대장 도착 💌"
        android:textColor="@color/champagne_gold"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/card_invitation_photo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 📬 설명 -->
    <TextView
        android:id="@+id/tv_invitation_msg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="연인이 사진과 함께 특별한 장소를 공유했습니다.\n지금 바로 내 지도에 핀을 꼽으시겠어요?"
        android:textColor="#BBFFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_invitation_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ⏳ 수신 상태 (애니메이션 예정) -->
    <LinearLayout
        android:id="@+id/layout_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_invitation_msg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/pb_invitation_loading"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="@color/champagne_gold"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tv_invitation_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="추억 정보를 불러오는 중"
            android:textColor="@color/champagne_gold"
            android:textSize="13sp"
            android:textStyle="italic" />
            
        <TextView
            android:id="@+id/tv_invitation_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="@color/champagne_gold"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 🔘 버튼 영역 -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/layout_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_invitation_cancel"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="나중에"
            android:textColor="#88FFFFFF"
            android:backgroundTint="#22FFFFFF"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btn_invitation_accept"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1.2"
            android:layout_marginStart="4dp"
            android:text="수락 📍"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:backgroundTint="@color/champagne_gold"
            android:enabled="false"
            android:alpha="0.5"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
