<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingHorizontal="32dp"
    android:paddingTop="16dp"
    android:paddingBottom="48dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="6dp"
        android:background="@drawable/bg_gold_pill_button"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/text_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_gold_pill_button"
            android:backgroundTint="#99221018"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:fontFamily="@font/kyobo_hand_family"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_delete_memory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="🗑️ 삭제"
            android:textColor="#FF4D4D"
            android:background="@drawable/bg_gold_pill_button"
            android:backgroundTint="#99221018"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:fontFamily="@font/kyobo_hand_family"
            android:textSize="14sp" />
    </FrameLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dialog_card_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <!-- 🗺️ [프리미엄 액션 바] 갤러리 상세보기와 동일한 고품격 디자인 적용 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <!-- 📤 [공유하기] 미드나잇 글래스 스타일 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_share_image"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_card_premium"
                android:backgroundTint="#2D2D2D"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_modern_share"
                    app:tint="#FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="공유하기"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/kyobo_hand_family" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 🚗 [길찾기] 골든 프리미엄 스타일 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_get_directions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginHorizontal="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gold_pill_button"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_modern_navigation"
                    app:tint="#221018" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="길찾기"
                    android:textColor="#221018"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/kyobo_hand_family" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 🏙️ [로드뷰] 미드나잇 글래스 스타일 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_open_roadview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_card_premium"
                android:backgroundTint="#334455"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_modern_roadview"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="로드뷰"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/kyobo_hand_family" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</LinearLayout>
