<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_dark_maroon">

    <!-- 맵 컨테이너 -->
    <FrameLayout
        android:id="@+id/memory_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 상단 뒤로가기 버튼 -->
    <Button
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← 돌아가기"
        android:backgroundTint="#FFD700"
        android:textColor="#000000"
        android:textSize="14sp"
        android:fontFamily="@font/kyobo_hand_family"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:elevation="12dp"/>

    <!-- 🔄 추억 동기화 (복원) 버튼 -->
    <Button
        android:id="@+id/btn_sync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔄 추억 복원"
        android:backgroundTint="#FFD700"
        android:textColor="#000000"
        android:textSize="14sp"
        android:fontFamily="@font/kyobo_hand_family"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp"
        android:elevation="12dp"/>

    <!-- 추억 타이틀 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="우리의 추억 지도 🗺️"
        android:textColor="#221018"
        android:textSize="18sp"
        android:fontFamily="@font/kyobo_hand_family"
        android:textStyle="bold"
        android:background="@drawable/bg_gold_pill_button"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp" />

    <!-- 🎨 지도 꾸미기 버튼 (좌측 하단 복구) -->
    <Button
        android:id="@+id/btn_map_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎨 지도 꾸미기"
        android:backgroundTint="#FFD700"
        android:textColor="#000000"
        android:textSize="13sp"
        android:fontFamily="@font/kyobo_hand_family"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="32dp"
        android:elevation="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"/>

    <!-- 🗺️ 지도 뷰 전환 패널 (우측 중앙 신규) -->
    <LinearLayout
        android:id="@+id/ll_view_modes"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_white_pill_translucent"
        android:paddingStart="1dp"
        android:paddingEnd="1dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="8dp"
        android:elevation="12dp"
        android:gravity="center">

        <!-- 2D 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_view_normal"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_view_normal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="2D"
                android:scaleType="centerInside"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2D"
                android:textColor="#333333"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- sky 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="14dp">
            <ImageButton
                android:id="@+id/btn_view_skyview"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_view_skyview"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="sky"
                android:scaleType="centerInside"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="sky"
                android:textColor="#333333"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ▶️ 추억 재생 버튼 (우측 하단 원상복구) -->
    <Button
        android:id="@+id/btn_play_path"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▶️ 추억 따라가기"
        android:backgroundTint="#FFD700"
        android:textColor="#000000"
        android:textSize="13sp"
        android:fontFamily="@font/kyobo_hand_family"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="32dp"
        android:elevation="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
