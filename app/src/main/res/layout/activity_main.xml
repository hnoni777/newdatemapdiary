<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#000000">

    <!-- 🥂 [프리미엄 헤더] 럭셔리 대시보드 개편 -->
    <LinearLayout
        android:id="@+id/luxury_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ✨ [App Logo] -->
        <TextView
            android:id="@+id/tv_main_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HereWithYou"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />
    </LinearLayout>

    <!-- 📜 [메인 다꾸 및 스크롤 영역] -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_nested_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/luxury_header_container">

        <LinearLayout
            android:id="@+id/capture_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="40dp">

            <!-- 🖼️ [다꾸/카드 통합 영역] -->
            <FrameLayout
                android:id="@+id/card_frame_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- 🥂 [메인 전용 3D 액자 틀] -->
                <View
                    android:id="@+id/dashboard_3d_frame"
                    android:layout_width="match_parent"
                    android:layout_height="315dp"
                    android:background="@drawable/bg_3d_frameless"
                    android:visibility="visible" />

                <!-- 🃏 [실제 카드/초대장 컨테이너] -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_inner_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <FrameLayout
                        android:id="@+id/card_preview_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- ✨ Card Edit Button (추억카드 꾸미기) -->
            <Button
                android:id="@+id/btn_create_card"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="40dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_premium_action_button"
                android:elevation="12dp"
                android:text="추억카드 꾸미기 ✨"
                android:textColor="@color/champagne_gold"
                android:fontFamily="serif"
                android:textSize="14sp"
                android:letterSpacing="0.02"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_modern_gallery"
                android:drawablePadding="8dp"
                android:paddingHorizontal="20dp"
                android:drawableTint="@color/champagne_gold"
                android:visibility="gone" />

            <!-- 🔘 버튼 바 (다꾸 이미지 바로 아래) -->
            <LinearLayout
                android:id="@+id/floating_action_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="2dp">
                <ImageButton android:id="@+id/btn_camera" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_modern_camera" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/white" android:padding="10dp" />
                <ImageButton android:id="@+id/btn_gallery" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_modern_gallery" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/white" android:padding="11dp" />
                <ImageButton android:id="@+id/btn_save_photo" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_modern_download" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/white" android:padding="12dp" />
                <ImageButton android:id="@+id/btn_share_photo" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_modern_share" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/white" android:padding="12dp" />
                <ImageButton android:id="@+id/btn_screenshot" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_modern_screenshot" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/white" android:padding="12dp" />
            </LinearLayout>

            <!-- 발자국 대시보드 -->
            <LinearLayout
                android:id="@+id/couple_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dashboard_card"
                android:padding="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="총 발자국" android:textColor="#88FFFFFF" android:textSize="10sp" />
                    <TextView android:id="@+id/text_memory_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0개" android:textColor="#FFFFFF" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="자주 가는 곳" android:textColor="#88FFFFFF" android:textSize="10sp" />
                    <TextView android:id="@+id/text_hot_spot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#FFD700" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="마지막 기록" android:textColor="#88FFFFFF" android:textSize="10sp" />
                    <TextView android:id="@+id/text_latest_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#FFFFFF" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 주소 (은닉) -->
            <TextView
                android:id="@+id/text_address"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="위치 로딩 중..." />

            <!-- 🔳 [럭셔리 트윈 버튼] 하단으로 이동됨 -->
            <LinearLayout
                android:id="@+id/twin_button_container"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- 🗺️ [내 추억지도] -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_memory_map"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardElevation="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gold_border" />
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@android:color/transparent">
                            
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_memory_map_bg"
                                android:alpha="0.85" />
                        </androidx.cardview.widget.CardView>

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="12dp"
                            android:src="@drawable/ic_red_heart_marker" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp"
                            android:text="내 추억지도"
                            android:textColor="#D4AF37"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:shadowColor="#000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="3" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- 📍 [프로필 설정] -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_profile_settings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardElevation="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gold_border" />
                        
                        <ImageView
                            android:id="@+id/img_header_profile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:layout_margin="12dp"
                            android:src="@drawable/ic_white_profile"
                            android:alpha="0.95" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp"
                            android:text="프로필 설정"
                            android:textColor="#D4AF37"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:shadowColor="#000000"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="3" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- 🎯 지도 팝업 트리거 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_show_map_popup"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#221018"
                android:layout_marginHorizontal="60dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="📍 우리의 현재 위치는 어디일까요?"
                    android:textColor="#FFD700"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 🗺️ [팝업] 슬라이드 지도 레이어 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/map_popup_layer"
        android:layout_width="match_parent"
        android:layout_height="480dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="32dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#000000">

        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <FrameLayout android:id="@+id/map_container" android:layout_width="match_parent" android:layout_height="match_parent" />
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_map_picture_frame" />
            
            <ImageButton
                android:id="@+id/btn_close_map"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_modern_navigation"
                android:rotation="180"
                android:background="@drawable/bg_circle_gold"
                app:tint="#000000"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>