<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#000000">

    <!-- 🗺️ Premium Map Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/map_card"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp">
        
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <FrameLayout
                android:id="@+id/map_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 🖼️ Picture Frame Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_map_picture_frame"
                android:clickable="false"
                android:focusable="false" />

            <!-- 🗺️ My Memory Map Button -->
            <Button
                android:id="@+id/btn_memory_map"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺️ 내 추억지도"
                android:backgroundTint="#FFD700"
                android:textColor="#000000"
                android:textSize="14sp"
                android:fontFamily="@font/kyobo_hand_family"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                android:elevation="12dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"/>

            <!-- 📍 Profile Settings Button -->
            <Button
                android:id="@+id/btn_profile_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="프로필 설정 📍"
                android:backgroundTint="#FFD700"
                android:textColor="#000000"
                android:textSize="14sp"
                android:fontFamily="@font/kyobo_hand_family"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                android:elevation="12dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- 📜 Main Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/map_card">

        <LinearLayout
            android:id="@+id/capture_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <!-- 👣 [PREMIUM] Footprint Analytics Dashboard -->
            <LinearLayout
                android:id="@+id/couple_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dashboard_card"
                android:padding="16dp"
                android:elevation="4dp">

                <!-- 1. Total Footprints -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="총 발자국"
                        android:textColor="#BBFFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/kyobo_hand_family" />
                    <TextView
                        android:id="@+id/text_memory_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0개"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="#30FFFFFF" />

                <!-- 2. Top Territory -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="자주 가는 곳"
                        android:textColor="#BBFFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/kyobo_hand_family" />
                    <TextView
                        android:id="@+id/text_hot_spot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="찾는 중..."
                        android:textColor="#FFD700"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="#30FFFFFF" />

                <!-- 3. Latest Activity -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="마지막 기록"
                        android:textColor="#BBFFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/kyobo_hand_family" />
                    <TextView
                        android:id="@+id/text_latest_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 🔘 Refined Floating Action Bar -->
            <LinearLayout
                android:id="@+id/floating_action_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_glass_card_gold"
                android:padding="6dp"
                android:elevation="8dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center">

                <ImageButton
                    android:id="@+id/btn_camera"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_modern_camera"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"
                    android:contentDescription="사진 촬영" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="#30FFFFFF"
                    android:layout_marginHorizontal="6dp" />

                <ImageButton
                    android:id="@+id/btn_save_photo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_modern_download"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"
                    android:contentDescription="저장" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="#30FFFFFF"
                    android:layout_marginHorizontal="6dp" />

                <ImageButton
                    android:id="@+id/btn_screenshot"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_modern_screenshot"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"
                    android:contentDescription="스샷 캡처" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="#30FFFFFF"
                    android:layout_marginHorizontal="6dp" />

                <ImageButton
                    android:id="@+id/btn_share_photo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_modern_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"
                    android:contentDescription="흔적 남기기" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="#30FFFFFF"
                    android:layout_marginHorizontal="6dp" />

                <ImageButton
                    android:id="@+id/btn_gallery"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_modern_gallery"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"
                    android:contentDescription="보관함" />
            </LinearLayout>

            <!-- 📍 Address Section -->
            <TextView
                android:id="@+id/text_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="주소를 불러오고 있습니다..."
                android:textColor="@color/white"
                android:textSize="14sp"
                android:alpha="0.8"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_white_location"
                android:drawableTint="#FFFFFF"
                android:drawablePadding="8dp" />

            <!-- ✨ Card Edit Button -->
            <Button
                android:id="@+id/btn_create_card"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="40dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_premium_action_button"
                android:elevation="12dp"
                android:text="추억카드 꾸미기 ✨"
                android:textColor="@color/champagne_gold"
                android:fontFamily="serif"
                android:textSize="14sp"
                android:letterSpacing="0.02"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_modern_gallery"
                android:drawablePadding="8dp"
                android:paddingHorizontal="20dp"
                android:drawableTint="@color/champagne_gold" />

            <!-- 💌 Live Preview Container -->
            <FrameLayout
                android:id="@+id/card_preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>